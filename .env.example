# Site
NEXT_PUBLIC_SITE_URL=https://okandemir.org
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ID=

# MySQL (Railway)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# YouTube feed
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Instagram feed
INSTAGRAM_ACCESS_TOKEN=

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — tanımlıysa webhook X-Hub-Signature-256 imzası zorunlu
WHATSAPP_APP_SECRET=
# Owner numarası (ONAY OD-XXXX komutu yalnızca buradan)
WHATSAPP_OWNER_NUMBER=905552677739

# LLM (varsayılan KAPALI — kota yok, crawl/şablon yeter)
# Açmak istersen: USE_LLM=1 + aşağıdaki key'lerden en az biri
USE_LLM=0
GROQ_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- AI Orkestratör SaaS (varsayılan KAPALI) ---
# 1 olunca /panel, /api/auth, /api/ai/tasks|approvals|usage|worker açılır. Önce migration 001-004 uygulanmalı.
AI_ORCHESTRATOR_ENABLED=0
# off: model yok (kural/şablon) · mock: ağsız sahte model · live: gerçek sağlayıcılar. Boşsa USE_LLM'e göre
AI_PROVIDER_MODE=
# Ücretli model fallback (OpenAI/OpenRouter) yalnızca 1 ise ve bütçe varsa
AI_ALLOW_PAID=0
# Görev başı maliyet tavanı (USD, kodda üst sınır 1)
AI_TASK_MAX_COST_USD=0.05
# Kotası doğrulanmamış (unknown) modeller için günlük istek tavanı
AI_UNKNOWN_QUOTA_DAILY_CAP=50
# Kalite modeli (purpose=quality, ücretli)
AI_QUALITY_MODEL=gpt-4o
# Herkese açık ücretsiz mini denetim (/hizmetler/ai-denetim formu). Migration 005 gerekir
AI_MINI_AUDIT_ENABLED=0
# Ayrı Railway worker servisi: aynı repo + AI_WORKER_LOOP=1 (web servisinde KAPALI kalsın)
AI_WORKER_LOOP=0
AI_WORKER_INTERVAL_MS=15000
# NVIDIA API Catalog: yalnız geliştirme/test (production'da router reddeder — lisans gerekir)
AI_ENABLE_NVIDIA=0
NVIDIA_API_KEY=
# Hugging Face Inference Providers: ücretli sayılır (aylık küçük kredi sonrası kullandıkça öde)
AI_ENABLE_HF=0
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:cheapest
# OAuth token şifreleme anahtarı (uzun rastgele değer)
APP_ENCRYPTION_KEY=

# Auth.js — AUTH_SECRET zorunlu (npx auth secret ile üretin). Google opsiyonel
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# n8n entegrasyonu
N8N_WEBHOOK_URL=

# Admin / dahili API koruması (production'da ZORUNLU — tanımsızsa dahili route'lar 401 döner)
# x-api-key veya Authorization: Bearer header
# n8n servisinde de AYNI değeri INTERNAL_API_KEY olarak ekleyin ($env.INTERNAL_API_KEY)
INTERNAL_API_KEY=

# Havale IBAN sitede / e-postada YAYINLANMAZ.
# Ödeme bilgisi yalnızca WhatsApp özel mesajla paylaşılır.
EMAIL_ADMIN=info@okandemir.org
